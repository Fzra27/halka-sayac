#!/usr/bin/python3
import math
from pathlib import Path
import shutil
import subprocess
import time
import tkinter as tk

BG = "#000000"
CARD = "#161616"
HOVER = "#303030"
TEXT = "#f5f5f5"
MUTED = "#ababab"
UI_FONT = "DejaVu Sans"
CLOCK_FONT = "DejaVu Sans Mono"
PALETTE = {
    "Turuncu": "#ffad63",
    "Kırmızı": "#ff747d",
    "Yeşil": "#68deb0",
    "Mavi": "#72bdff",
}


class Timer:
    def __init__(self, window):
        self.window = window
        self.total = self.remaining = 60
        self.deadline = None
        self.pending = None
        self.paused = False
        self.space_pending = None
        self.color = tk.StringVar(value="Turuncu")
        self.status = tk.StringVar(value="Hazır")
        window.title("Halka Sayaç")
        window.configure(bg=BG)
        window.option_add("*Font", (UI_FONT, 10))
        window.option_add("*highlightBackground", BG)
        window.option_add("*highlightColor", MUTED)

        tk.Label(window, text="Halka Sayaç", font=(UI_FONT, 20, "bold"),
                 bg=BG, fg=TEXT).pack(pady=(20, 4))
        self.dial = tk.Canvas(window, width=248, height=248, bg=BG,
                              highlightthickness=0)
        self.dial.pack(fill="both", expand=True, padx=20, pady=8)
        self.track = self.dial.create_oval(16, 16, 232, 232, outline=CARD, width=11)
        self.full = self.dial.create_oval(16, 16, 232, 232, width=11)
        self.arc = self.dial.create_arc(16, 16, 232, 232, start=90,
                                        style=tk.ARC, width=11)
        self.clock = self.dial.create_text(124, 124, fill=TEXT,
                                           font=(CLOCK_FONT, 34))
        self.status_label = tk.Label(window, textvariable=self.status, bg=BG,
                                     fg=MUTED, font=(UI_FONT, 11, "bold"))
        self.status_label.pack()

        inputs = tk.Frame(window, bg=BG)
        inputs.pack(pady=14)
        self.minutes = tk.StringVar(value="1")
        self.seconds = tk.StringVar(value="0")
        self.fields = []
        for column, (label, variable, limit) in enumerate([
            ("Dakika", self.minutes, 999), ("Saniye", self.seconds, 59)
        ]):
            tk.Label(inputs, text=label, bg=BG, fg=MUTED).grid(row=0, column=column)
            field = tk.Spinbox(inputs, from_=0, to=limit, textvariable=variable,
                               width=6, justify="center", bg=CARD, fg=TEXT,
                               insertbackground=TEXT, disabledbackground=CARD,
                               disabledforeground=MUTED, buttonbackground=CARD,
                               relief="flat", font=(CLOCK_FONT, 13))
            field.grid(row=1, column=column, padx=8, pady=4, ipady=4)
            self.fields.append(field)
            variable.trace_add("write", self.edit_duration)

        actions = tk.Frame(window, bg=BG)
        actions.pack()
        self.toggle_button = tk.Button(actions, text="Başlat", width=12,
                                       command=self.toggle, relief="flat",
                                       fg=BG, activeforeground=BG, pady=6)
        self.toggle_button.pack(side="left", padx=5)
        tk.Button(actions, text="Sıfırla", width=10, command=self.reset, relief="flat",
                  bg=CARD, fg=TEXT, activebackground=HOVER, activeforeground=TEXT,
                  pady=6).pack(side="left", padx=5)

        self.fullscreen_button = tk.Button(
            actions, text="Tam ekran", command=self.toggle_fullscreen,
            relief="flat", bg=CARD, fg=TEXT, activebackground=HOVER,
            activeforeground=TEXT, pady=6,
        )
        self.fullscreen_button.pack(side="left", padx=5)

        colors = tk.Frame(window, bg=BG)
        colors.pack(pady=(18, 24), padx=18)
        for name, color in PALETTE.items():
            tk.Radiobutton(colors, text=name, value=name, variable=self.color,
                           command=self.render, indicatoron=False, relief="flat",
                           bg=CARD, fg=color, selectcolor=HOVER,
                           activebackground=HOVER, activeforeground=color,
                           padx=7, pady=5).pack(side="left", padx=3)
        self.dial.bind("<Configure>", self.resize_dial)
        window.bind("<F11>", self.toggle_fullscreen)
        window.bind("<Escape>", self.exit_fullscreen)
        shortcut_tag = "HalkaSayacShortcuts"
        window.bind_class(shortcut_tag, "<KeyPress-space>", self.space_pressed)
        window.bind_class(shortcut_tag, "<KeyRelease-space>", self.space_released)
        widgets = [window]
        while widgets:
            widget = widgets.pop()
            widget.bindtags((shortcut_tag, *widget.bindtags()))
            widgets.extend(widget.winfo_children())
        window.update_idletasks()
        window.minsize(window.winfo_reqwidth(), window.winfo_reqheight() - 80)
        self.render()

    def space_pressed(self, _event):
        # X11 autorepeat can send a release immediately before each repeated press.
        if self.space_pending is not None:
            self.window.after_cancel(self.space_pending)
            self.space_pending = None
        return "break"

    def space_released(self, _event):
        if self.space_pending is None:
            self.space_pending = self.window.after_idle(self.toggle_from_space)
        return "break"

    def toggle_from_space(self):
        self.space_pending = None
        self.toggle()

    def toggle_fullscreen(self, _event=None):
        self.set_fullscreen(not self.window.attributes("-fullscreen"))

    def exit_fullscreen(self, _event=None):
        self.set_fullscreen(False)

    def set_fullscreen(self, enabled):
        self.window.attributes("-fullscreen", enabled)
        self.fullscreen_button.configure(text="Tam ekrandan çık" if enabled else "Tam ekran")

    def resize_dial(self, event):
        size = min(event.width, event.height)
        center_x, center_y = event.width / 2, event.height / 2
        radius = size * 0.435
        bounds = (center_x - radius, center_y - radius,
                  center_x + radius, center_y + radius)
        for item in (self.track, self.full, self.arc):
            self.dial.coords(item, *bounds)
            self.dial.itemconfigure(item, width=max(2, size * 0.044))
        self.dial.coords(self.clock, center_x, center_y)
        self.dial.itemconfigure(
            self.clock, font=(CLOCK_FONT, -max(12, round(size * 0.18)))
        )

    def duration(self):
        try:
            minutes, seconds = int(self.minutes.get()), int(self.seconds.get())
        except ValueError:
            return 0
        if not (0 <= minutes <= 999 and 0 <= seconds <= 59):
            return 0
        return minutes * 60 + seconds

    def edit_duration(self, *_):
        self.total = self.remaining = self.duration()
        self.status.set("Hazır")
        self.render()

    def render(self):
        seconds = math.ceil(self.remaining)
        minutes, seconds = divmod(seconds, 60)
        self.dial.itemconfigure(self.clock, text=f"{minutes:02d}:{seconds:02d}")
        accent = PALETTE[self.color.get()]
        self.status_label.configure(fg=accent if self.status.get() == "Süre doldu!" else MUTED)
        progress = self.remaining / self.total if self.total else 0
        self.dial.itemconfigure(self.full, outline=accent,
                                state="normal" if progress == 1 else "hidden")
        self.dial.itemconfigure(self.arc, outline=accent, extent=-360 * progress,
                                state="normal" if 0 < progress < 1 else "hidden")
        self.toggle_button.configure(bg=accent, activebackground=accent)

    def update_controls(self):
        running = self.deadline is not None
        for field in self.fields:
            field.configure(state="disabled" if running or self.paused else "normal")
        label = "Devam et" if self.paused else "Başlat"
        self.toggle_button.configure(text="Duraklat" if running else label)

    def toggle(self):
        if self.deadline is not None:
            self.window.after_cancel(self.pending)
            self.pending = None
            self.remaining = max(0, self.deadline - time.monotonic())
            if self.remaining == 0:
                self.finish()
                return
            self.deadline = None
            self.paused = True
            self.status.set("Duraklatıldı")
            self.update_controls()
            self.render()
            return

        if not self.paused:
            self.total = self.remaining = self.duration()
        if not self.remaining:
            self.status.set("Geçerli ve sıfırdan büyük bir süre gir.")
            return
        self.deadline = time.monotonic() + self.remaining
        self.paused = False
        self.status.set("Geri sayıyor")
        self.update_controls()
        self.tick()

    def tick(self):
        self.pending = None
        self.remaining = max(0, self.deadline - time.monotonic())
        if self.remaining == 0:
            self.finish()
            return
        self.render()
        self.pending = self.window.after(40, self.tick)

    def finish(self):
        self.deadline = None
        self.status.set("Süre doldu!")
        self.update_controls()
        self.render()
        self.notify_finished()

    def notify_finished(self):
        if shutil.which("notify-send"):
            try:
                subprocess.Popen([
                    "notify-send", "--app-name=Halka Sayaç",
                    "--icon=halka-sayac", "--urgency=critical",
                    "Süre doldu!", "Geri sayım tamamlandı.",
                ])
            except OSError:
                pass

        prefix = Path(__file__).resolve().parent.parent
        alarm = prefix / "share/halka-sayac/alarm.wav"
        if not alarm.is_file():
            alarm = Path(__file__).resolve().parent / "packaging/alarm.wav"
        for player in ("paplay", "pw-play"):
            if alarm.is_file() and shutil.which(player):
                try:
                    subprocess.Popen([player, str(alarm)])
                    return
                except OSError:
                    continue
        self.window.bell()

    def reset(self):
        if self.pending is not None:
            self.window.after_cancel(self.pending)
            self.pending = None
        self.deadline = None
        self.paused = False
        self.update_controls()
        self.edit_duration()


if __name__ == "__main__":
    root = tk.Tk(className="HalkaSayac")
    Timer(root)
    root.mainloop()
